is_a: GO:0006400 ! tRNA modification

[Term]
id: GO:0002098
name: tRNA wobble uridine modification
namespace: biological_process
def: "The process in which a uridine at position 34 of a tRNA is post-transcriptionally modified. The wobble nucleoside of the tRNA sequence  (position 34) corresponds to the first position of the anticodon." [GOC:hjd, ISBN:155581073X]
is_a: GO:0002097 ! tRNA wobble base modification

[Term]
id: GO:0002099
name: tRNA wobble guanine modification
namespace: biological_process
