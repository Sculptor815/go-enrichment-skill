id: GO:0019969
name: interleukin-10 binding
namespace: molecular_function
def: "Binding to interleukin-10." [GOC:jl]
synonym: "IL-10 binding" EXACT []
is_a: GO:0019838 ! growth factor binding
is_a: GO:0019955 ! cytokine binding

