synonym: "PIC" NARROW []
synonym: "preinitiation complex" NARROW []
synonym: "transcriptional pre-initiation complex" EXACT []
synonym: "transcriptional preinitiation complex" EXACT []
is_a: GO:0032993 ! protein-DNA complex

