synonym: "PtdIns(3,5)P2 binding" EXACT []
is_a: GO:1901981 ! phosphatidylinositol phosphate binding
is_a: GO:1902936 ! phosphatidylinositol bisphosphate binding

[Term]
id: GO:0080042
