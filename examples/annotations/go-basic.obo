synonym: "cytosolic calcium ion transport" BROAD []
is_a: GO:0070588 ! calcium ion transmembrane transport

[Term]
id: GO:0097574
name: lateral part of cell
namespace: cellular_component
def: "The region of a polarized cell other than its tips or ends (in some cell types, one end may be called the apex and the other the base). For example, in a polarized epithelial cell, the lateral part includes the cell sides which interface adjacent cells." [GOC:pr]
is_a: GO:0110165 ! cellular anatomical structure

