[Term]
id: GO:0086002
name: cardiac muscle cell action potential involved in contraction
namespace: biological_process
def: "An action potential that occurs in a cardiac muscle cell and is involved in its contraction." [GOC:BHF, GOC:mtg_cardiac_conduct_nov11]
