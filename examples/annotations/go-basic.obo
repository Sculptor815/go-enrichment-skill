subset: goslim_synapse
is_a: GO:0045202 ! synapse

[Term]
id: GO:0098686
name: hippocampal mossy fiber to CA3 synapse
namespace: cellular_component
def: "One of the giant synapses that form between the mossy fiber axons of dentate gyrus granule cells and the large complex spines of CA3 pyramidal cells. It consists of a giant bouton known as the mossy fiber expansion, synapsed to the complex, multiheaded spine (thorny excresence) of a CA3 pyramidal cell." [DOI:10.1002/1096-9861, PMID:13869693, PMID:23264762]
subset: goslim_synapse
is_a: GO:0098984 ! neuron to neuron synapse

