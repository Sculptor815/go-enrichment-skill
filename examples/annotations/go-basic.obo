is_a: GO:0048284 ! organelle fusion

[Term]
id: GO:0097581
name: lamellipodium organization
namespace: biological_process
def: "A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of a lamellipodium. A lamellipodium is a thin sheetlike process extended by the leading edge of a crawling fibroblast; contains a dense meshwork of actin filaments." [GOC:als, PMID:16054028]
is_a: GO:0120036 ! plasma membrane bounded cell projection organization

[Term]
id: GO:0097587
name: MutLgamma complex
namespace: cellular_component
def: "A heterodimer involved in the recognition of base-base and small insertion/deletion mismatches. In S. cerevisiae the complex consists of two subunits, Mlh1 and Mlh3." [GOC:jd, PMID:10570173]
is_a: GO:0032300 ! mismatch repair complex

