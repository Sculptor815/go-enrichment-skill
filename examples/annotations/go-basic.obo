synonym: "IFN-gamma binding" EXACT [GOC:mah]
synonym: "IFNG binding" EXACT [GOC:mah]
synonym: "interferon-gamma binding" BROAD [PMID:15546383, PR:000024990]
is_a: GO:0019961 ! interferon binding

